{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "injection-reminder",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "REMINDER_DEVICE", "class_name": "ReminderDevice" },
      { "name": "PUSH_CONFIG", "class_name": "PushConfig" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReminderDevice", "PushConfig"] }]
}
